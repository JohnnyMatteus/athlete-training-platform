# Valores de desenvolvimento. Copie para .env (ignorado pelo Git). Nunca use em produção.
COMPOSE_PROJECT_NAME=atp

POSTGRES_USER=atp
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=atp
RABBITMQ_DEFAULT_PASS=dev-only-change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_ROOT_USER=atp-minio
MINIO_ROOT_PASSWORD=dev-only-change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
UPLOADS_BUCKET=uploads

TUSD_PORT=8080
# A API roda no host em desenvolvimento (Hyperf, porta 9501); dentro do container use host.docker.internal.
TUSD_HOOK_URL=http://host.docker.internal:9501/hooks/tus

# Atleta sintético fixo (M1 não tem autenticação)
ATHLETE_ID=2f0f0a2e-6a53-4c3a-9d8e-1b7e6c5d4a01
