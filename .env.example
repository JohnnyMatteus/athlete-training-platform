# Valores de desenvolvimento. Copie para .env (ignorado pelo Git). Nunca use em produção.
COMPOSE_PROJECT_NAME=atp

POSTGRES_USER=atp
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=atp
RABBITMQ_DEFAULT_PASS=dev-only-change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_ROOT_USER=atp-minio
MINIO_ROOT_PASSWORD=dev-only-change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
UPLOADS_BUCKET=uploads

TUSD_PORT=8080

# Worker de ingestão. Os valores abaixo são os do compose (host "postgres", "rabbitmq", "minio").
# Para rodar o worker no host, troque os hosts por localhost e as portas publicadas.
INGEST_DATABASE_URL=postgres://atp:dev-only-change-me@postgres:5432/atividades?sslmode=disable
RABBITMQ_URL=amqp://atp:dev-only-change-me@rabbitmq:5672/
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
# Tentativas antes de marcar um arquivo como falho e tamanho do lote do COPY (padrões do worker: 3 e 5000)
INGEST_MAX_ATTEMPTS=3
INGEST_COPY_BATCH=5000

# A API valida JWT RS256 (ADR 0011). A chave pública vem de services/api/runtime/jwt_public.pem
# (diretório ignorado pelo Git); em desenvolvimento, gere o par de chaves de teste localmente.
JWT_ISSUER=https://idp.example.test/
JWT_AUDIENCE=athlete-api

# Atleta sintético fixo (M1 não tem autenticação)
ATHLETE_ID=2f0f0a2e-6a53-4c3a-9d8e-1b7e6c5d4a01

# Serviço de métricas (roda no host em desenvolvimento). Em produção, o usuário de amostras deve ter só SELECT (ADR 0012).
METRICS_DATABASE_URL=postgres://atp:dev-only-change-me@localhost:5432/metricas?sslmode=disable
ATIVIDADES_READONLY_URL=postgres://atp:dev-only-change-me@localhost:5432/atividades?sslmode=disable

# Coach IA (porta 8130; Redis interno para propostas e orçamento, sem porta no host; profile `coach`). O modelo real exige chave e id do modelo, definidos no seu .env.
COACH_PORT=8130
ANTHROPIC_API_KEY=
COACH_LLM_MODEL=
COACH_DAILY_TOKEN_BUDGET=60000
