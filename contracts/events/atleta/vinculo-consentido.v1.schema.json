{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.athlete-training-platform.example/events/atleta/vinculo-consentido.v1.schema.json",
  "title": "VinculoTreinadorConsentido",
  "description": "O atleta convidou um treinador e o treinador aceitou: a partir daqui o treinador pode ler os dados do atleta (RBAC, design doc 9). Publicado pelo serviço de Planejamento (que hospeda o contexto Atleta até ele ter serviço próprio, ADR 0013).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tipo",
    "versao",
    "ocorrido_em",
    "dados"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único do evento. Consumidores deduplicam por ele (entrega pelo menos uma vez)."
    },
    "tipo": {
      "const": "VinculoTreinadorConsentido"
    },
    "versao": {
      "const": 1,
      "description": "Versão do contrato. Mudança incompatível cria um arquivo .v2."
    },
    "ocorrido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Instante UTC em que o fato ocorreu."
    },
    "dados": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vinculo_id",
        "atleta_id",
        "treinador_id",
        "categorias"
      ],
      "properties": {
        "vinculo_id": {
          "type": "string",
          "format": "uuid"
        },
        "atleta_id": {
          "type": "string",
          "format": "uuid"
        },
        "treinador_id": {
          "type": "string",
          "format": "uuid"
        },
        "categorias": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "treinos",
              "frequencia_cardiaca",
              "plano"
            ]
          },
          "minItems": 1
        }
      }
    }
  }
}
