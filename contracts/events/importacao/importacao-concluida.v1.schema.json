{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.athlete-training-platform.example/events/importacao/importacao-concluida.v1.schema.json",
  "title": "ImportacaoConcluida",
  "description": "O lote terminou de ser processado. Publicado pelo worker; a API atualiza os totais do lote.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tipo",
    "versao",
    "ocorrido_em",
    "import_id",
    "dados"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único do evento. Consumidores deduplicam por ele (entrega pelo menos uma vez)."
    },
    "tipo": {
      "const": "ImportacaoConcluida"
    },
    "versao": {
      "const": 1,
      "description": "Versão do contrato. Mudança incompatível cria um arquivo .v2."
    },
    "ocorrido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Instante UTC em que o fato ocorreu."
    },
    "import_id": {
      "type": "string",
      "format": "uuid",
      "description": "Lote de importação ao qual o evento pertence."
    },
    "dados": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atleta_id",
        "importadas",
        "duplicadas",
        "erros",
        "versao_formato"
      ],
      "properties": {
        "atleta_id": {
          "type": "string",
          "format": "uuid"
        },
        "importadas": {
          "type": "integer",
          "minimum": 0
        },
        "duplicadas": {
          "type": "integer",
          "minimum": 0
        },
        "erros": {
          "type": "integer",
          "minimum": 0
        },
        "versao_formato": {
          "type": [
            "string",
            "null"
          ],
          "description": "Versão do formato do arquivo detectada pelo tradutor (mitigação do risco de mudança do export)."
        }
      }
    }
  }
}
