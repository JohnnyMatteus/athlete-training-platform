{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.athlete-training-platform.example/events/importacao/importacao-falhou.v1.schema.json",
  "title": "ImportacaoFalhou",
  "description": "O lote não pôde ser processado. Publicado pela API (sha256 divergente) ou pelo worker (após o limite de tentativas).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tipo",
    "versao",
    "ocorrido_em",
    "import_id",
    "dados"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único do evento. Consumidores deduplicam por ele (entrega pelo menos uma vez)."
    },
    "tipo": {
      "const": "ImportacaoFalhou"
    },
    "versao": {
      "const": 1,
      "description": "Versão do contrato. Mudança incompatível cria um arquivo .v2."
    },
    "ocorrido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Instante UTC em que o fato ocorreu."
    },
    "import_id": {
      "type": "string",
      "format": "uuid",
      "description": "Lote de importação ao qual o evento pertence."
    },
    "dados": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atleta_id",
        "codigo",
        "motivo",
        "tentativas"
      ],
      "properties": {
        "atleta_id": {
          "type": "string",
          "format": "uuid"
        },
        "codigo": {
          "type": "string",
          "enum": [
            "sha256_divergente",
            "arquivo_invalido",
            "formato_nao_suportado",
            "falha_interna"
          ]
        },
        "motivo": {
          "type": "string",
          "minLength": 1,
          "description": "Mensagem legível, sem dado de saúde."
        },
        "tentativas": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
