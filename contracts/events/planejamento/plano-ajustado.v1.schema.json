{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.athlete-training-platform.example/events/planejamento/plano-ajustado.v1.schema.json",
  "title": "PlanoAjustado",
  "description": "Um ajuste proposto (pelo atleta, treinador ou Coach) foi aceito pelo validador e gerou nova versão do plano.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tipo",
    "versao",
    "ocorrido_em",
    "dados"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único do evento. Consumidores deduplicam por ele (entrega pelo menos uma vez)."
    },
    "tipo": {
      "const": "PlanoAjustado"
    },
    "versao": {
      "const": 1,
      "description": "Versão do contrato. Mudança incompatível cria um arquivo .v2."
    },
    "ocorrido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Instante UTC em que o fato ocorreu."
    },
    "dados": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plano_id",
        "atleta_id",
        "versao_plano",
        "status",
        "motivo",
        "origem",
        "treinos_alterados"
      ],
      "properties": {
        "plano_id": {
          "type": "string",
          "format": "uuid"
        },
        "atleta_id": {
          "type": "string",
          "format": "uuid"
        },
        "versao_plano": {
          "type": "integer",
          "minimum": 2
        },
        "status": {
          "type": "string",
          "enum": [
            "aguardando_aprovacao",
            "ativo"
          ]
        },
        "motivo": {
          "type": "string"
        },
        "origem": {
          "type": "string",
          "enum": [
            "atleta",
            "treinador",
            "coach"
          ]
        },
        "treinos_alterados": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
