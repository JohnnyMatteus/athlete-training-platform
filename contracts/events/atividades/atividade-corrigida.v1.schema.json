{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.athlete-training-platform.example/events/atividades/atividade-corrigida.v1.schema.json",
  "title": "AtividadeCorrigida",
  "description": "Uma atividade já gravada foi corrigida (amostras, tipo ou horário). Publicado pelo contexto de Atividades; o serviço de métricas recalcula a carga da data afetada em diante.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tipo",
    "versao",
    "ocorrido_em",
    "dados"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único do evento. Consumidores deduplicam por ele (entrega pelo menos uma vez)."
    },
    "tipo": {
      "const": "AtividadeCorrigida"
    },
    "versao": {
      "const": 1,
      "description": "Versão do contrato. Mudança incompatível cria um arquivo .v2."
    },
    "ocorrido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Instante UTC em que o fato ocorreu."
    },
    "dados": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atleta_id",
        "atividade_id",
        "tipo",
        "inicio_utc",
        "duracao_s",
        "distancia_m"
      ],
      "properties": {
        "atleta_id": {
          "type": "string",
          "format": "uuid"
        },
        "atividade_id": {
          "type": "string",
          "format": "uuid"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "natacao_piscina",
            "natacao_aguas_abertas",
            "ciclismo_indoor",
            "ciclismo_outdoor",
            "corrida",
            "forca",
            "outro"
          ]
        },
        "inicio_utc": {
          "type": "string",
          "format": "date-time"
        },
        "duracao_s": {
          "type": "integer",
          "minimum": 0
        },
        "distancia_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "inicio_utc_anterior": {
          "type": "string",
          "format": "date-time",
          "description": "Início antes da correção, presente só quando o horário mudou; o recálculo parte do menor dos dois dias."
        }
      }
    }
  }
}
