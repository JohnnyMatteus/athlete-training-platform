# Variáveis do serviço de Planejamento (ver .env.example da raiz para a infraestrutura).
HTTP_PORT=8120
DB_HOST=127.0.0.1
DB_DATABASE=planejamento
DB_USERNAME=atp
DB_PASSWORD=dev-only-change-me
RABBITMQ_HOST=127.0.0.1
RABBITMQ_USER=atp
RABBITMQ_PASSWORD=dev-only-change-me
JWT_PUBLIC_KEY_FILE=../api/runtime/jwt_public.pem
JWT_ISSUER=https://idp.example.test/
