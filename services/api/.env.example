# Variáveis da API (ver .env.example da raiz para o restante da infraestrutura).
HTTP_PORT=9501
DB_HOST=127.0.0.1
DB_DATABASE=importacao
DB_USERNAME=atp
DB_PASSWORD=dev-only-change-me
RABBITMQ_HOST=127.0.0.1
RABBITMQ_USER=atp
RABBITMQ_PASSWORD=dev-only-change-me
S3_ENDPOINT=http://127.0.0.1:4566
S3_KEY=dev-only-localstack
S3_SECRET=dev-only-change-me
TUS_PUBLIC_URL=http://localhost:8080/files/
# Obrigatório: os hooks do tusd devem chamar /hooks/tus?token=<valor>; com o valor vazio a API recusa todos os hooks (403)
TUSD_HOOK_SECRET=dev-only-tusd-hook-secret
# Único bucket aceito no post-finish; hook com outro bucket é recusado sem ler o objeto
UPLOADS_BUCKET=uploads
JWT_PUBLIC_KEY_FILE=./runtime/jwt_public.pem
JWT_ISSUER=https://idp.example.test/
JWT_AUDIENCE=athlete-api
