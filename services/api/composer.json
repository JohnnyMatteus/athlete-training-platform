{
  "name": "athlete-training-platform/api",
  "description": "API de importacao da plataforma de treino (Hyperf, hexagonal)",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "aws/aws-sdk-php": "^3.407",
    "firebase/php-jwt": "^6.10",
    "hyperf/command": "~3.2.0",
    "hyperf/config": "~3.2.0",
    "hyperf/database-pgsql": "~3.2.0",
    "hyperf/db-connection": "~3.2.0",
    "hyperf/di": "~3.2.0",
    "hyperf/dispatcher": "~3.2.0",
    "hyperf/engine": "^2.10",
    "hyperf/framework": "~3.2.0",
    "hyperf/http-message": "~3.2.0",
    "hyperf/http-server": "~3.2.0",
    "hyperf/logger": "~3.2.0",
    "hyperf/server": "~3.2.0",
    "hyperf/validation": "~3.2.0",
    "opis/json-schema": "^2.3",
    "php-amqplib/php-amqplib": "^3.7",
    "psr/clock": "^1.0",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "config": { "sort-packages": true, "optimize-autoloader": true },
  "scripts": {
    "test": "phpunit --colors=always",
    "stan": "phpstan analyse --memory-limit=1G",
    "cs": "php-cs-fixer fix --dry-run --diff"
  }
}
